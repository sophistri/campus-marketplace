# Only needed when running the server WITHOUT Docker (cd server && npm start).
# Copy to server/.env: cp .env.example .env

PORT=5000
NODE_ENV=development

# Local MongoDB. (Inside docker compose this is set for you.)
MONGODB_URI=mongodb://localhost:27017/campus-marketplace

# Where the React app runs. Used for CORS and for links in verification emails.
CLIENT_URL=http://localhost:5173

# Two DIFFERENT random secrets. Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Comma-separated list of email domains allowed to sign up. Required: if empty, every signup is rejected.
ALLOWED_EMAIL_DOMAINS=example.edu

# Any SMTP server. For local dev, Mailpit (https://mailpit.axllent.org) catches mail at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev
SMTP_FROM=Campus Marketplace <noreply@campus.local>
